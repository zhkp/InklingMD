{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any spawned child windows",
  "windows": ["main", "inkling-*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "allow-list-dir",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-write-binary-file",
    "allow-file-mtime",
    "allow-rename-path",
    "allow-delete-path",
    "allow-create-file",
    "allow-create-dir",
    "allow-asset-dir",
    "allow-download-remote-image",
    "allow-find-asset-by-hash",
    "allow-search-in-workspace",
    "allow-list-workspace-files",
    "allow-pandoc-check",
    "allow-pandoc-export-docx",
    "allow-scan-theme-dir",
    "allow-copy-path",
    "allow-extract-zip",
    "allow-resource-themes-dir",
    "allow-take-pending-file"
  ]
}
